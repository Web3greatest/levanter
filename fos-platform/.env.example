# ═══════════════════════════════════════════════════════════════
# Founder Operating System — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# SECURITY: Never commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ── AI Providers (at least one required) ────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Model Routing ───────────────────────────────────────────────
PREFERRED_PROVIDER=anthropic
FAST_MODEL=claude-haiku-4-5-20251001
SMART_MODEL=claude-sonnet-4-6
DEEP_MODEL=claude-opus-4-8
VISION_MODEL=claude-sonnet-4-6

# ── Application ─────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-in-production
DEBUG=false

# ── Web Search (optional) ───────────────────────────────────────
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/fos.db

# ── Redis (optional) ────────────────────────────────────────────
REDIS_URL=

# ── Integrations (optional) ─────────────────────────────────────
ELEVENLABS_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
NOTION_TOKEN=
SLACK_BOT_TOKEN=

# ── File Storage ────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
