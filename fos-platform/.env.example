# ============================================================
# FOS Platform — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- AI Providers (at least one required) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=AIza-your-key-here

# --- Search (optional but recommended) ---
TAVILY_API_KEY=tvly-your-key-here
SERPER_API_KEY=your-serper-key-here

# --- AI Model Selection ---
PREFERRED_PROVIDER=anthropic
FAST_MODEL=claude-haiku-4-5-20251001
SMART_MODEL=claude-sonnet-4-6
DEEP_MODEL=claude-opus-4-8

# --- Database ---
# SQLite (default, zero config)
DATABASE_URL=sqlite+aiosqlite:///./data/fos.db
# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fos

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- Redis (optional, for background tasks) ---
REDIS_URL=redis://localhost:6379/0

# --- Frontend URLs ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Ollama (local AI, optional) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- ElevenLabs (voice, optional) ---
ELEVENLABS_API_KEY=your-key-here
ELEVENLABS_VOICE_ID=your-voice-id

# --- Integrations (optional) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SLACK_BOT_TOKEN=
NOTION_TOKEN=
GOOGLE_DRIVE_CREDENTIALS_PATH=
